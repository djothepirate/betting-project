# Copiez ce fichier vers .env, puis remplacez uniquement les valeurs locales.
# .env est ignoré par Git. N'y copiez aucune clé API football, donnée J7, clé privée ou certificat.
BETTING_DB_NAME=betting
BETTING_DB_USER=betting
BETTING_DB_PASSWORD=REPLACE_WITH_LOCAL_ONLY_PASSWORD
BETTING_DB_PORT=5433

# INT-001 reste inactif par défaut. Ces valeurs ne démarrent aucun sender et n'autorisent aucun
# appel SofaScore, Local Lab, VPS ou receiver distant.
BETTING_J7_RECEIVER_ENABLED=false
BETTING_J7_RETENTION_DAYS=30
BETTING_J7_CLIENT_CERTIFICATE_SHA256_ALLOWLIST=

# L'activation locale explicite exige simultanément les valeurs ci-dessous dans l'environnement
# du processus control-api. Ne versionnez jamais leurs valeurs réelles dans .env ou Git.
# BETTING_CONTROL_API_PORT=8444
# BETTING_J7_KEY_STORE=C:/secure/local-only/server.p12
# BETTING_J7_KEY_STORE_PASSWORD=TEST_ONLY_PLACEHOLDER
# BETTING_J7_KEY_STORE_TYPE=PKCS12
# BETTING_J7_TRUST_STORE=C:/secure/local-only/truststore.p12
# BETTING_J7_TRUST_STORE_PASSWORD=TEST_ONLY_PLACEHOLDER
# BETTING_J7_TRUST_STORE_TYPE=PKCS12
